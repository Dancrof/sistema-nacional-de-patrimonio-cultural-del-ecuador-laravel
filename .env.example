# VARIABLES DE CONFIGURACION DE LA APLICACION
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:${APP_PORT}

# VARIABLES DE LOCALIZACION DE LA APLICACION
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# VARIABLES DE CONFIGURACION DE MANTENIMIENTO
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

## VARIABLES DE CONFIGURACION DEL SERVIDOR PHP
# PHP_CLI_SERVER_WORKERS=4

# VARIABLES DE CONFIGURACION DE SEGURIDAD
BCRYPT_ROUNDS=12

# VARIABLES DE CONFIGURACION DE LOGS
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# VARIABLES DE CONFIGURACION DE BASE DE DATOS
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# VARIABLES DE CONFIGURACION DE SESIONES
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# VARIABLES DE CONFIGURACION DE COLAS Y SISTEMA DE ARCHIVOS
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# VARIABLES DE CONFIGURACION DE CACHE
CACHE_STORE=database
# CACHE_PREFIX=

# VARIABLES DE CONFIGURACION DE MEMCACHED --- IGNORE ---
MEMCACHED_HOST=127.0.0.1

# VARIABLES DE CONFIGURACION DE REDIS
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# VARIABLES DE CONFIGURACION DE MAIL
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# VARIABLES DE CONFIGURACION DE AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# VARIABLES DE CONFIGURACION DE VITE
VITE_APP_NAME="${APP_NAME}"

#PUERTOS DE SERVICIOS DE DOCkER
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6380